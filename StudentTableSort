// StudentTableSort.java
import javax.swing.*;
import javax.swing.table.*;
import java.awt.*;

public class StudentTableSort {
    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            JFrame frame = new JFrame("Student Table - Sortable");
            frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
            frame.setSize(500, 300);
            frame.setLocationRelativeTo(null);

            // Column names
            String[] cols = { "Name", "Age", "Grade" };

            // Data: note Age as Integer (so sorting is numeric)
            Object[][] data = {
                { "Ravi", 18, "A" },
                { "Priya", 17, "B+" },
                { "Ajay", 19, "A-" },
                { "Sneha", 18, "B" },
                { "Karan", 16, "A+" }
            };

            // Use DefaultTableModel but override getColumnClass so Age sorts numerically
            DefaultTableModel model = new DefaultTableModel(data, cols) {
                @Override
                public Class<?> getColumnClass(int columnIndex) {
                    if (columnIndex == 1) return Integer.class; // Age
                    return String.class; // Name, Grade
                }

                // Make cells non-editable (optional)
                @Override
                public boolean isCellEditable(int row, int column) {
                    return false;
                }
            };

            JTable table = new JTable(model);
            table.setAutoCreateRowSorter(true); // simple way to enable sorting

            // Alternatively, a TableRowSorter gives more control:
            TableRowSorter<TableModel> sorter = new TableRowSorter<>(model);
            table.setRowSorter(sorter);

            // Small UI polish
            table.setFillsViewportHeight(true);
            table.getTableHeader().setReorderingAllowed(false);

            frame.add(new JScrollPane(table), BorderLayout.CENTER);
            frame.setVisible(true);
        });
    }
}
